        </mxCell>
        <mxCell id="e_action_confirm" value="confirm" edge="1" parent="1" source="dec_action" target="dec_mode" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;">
