        <mxCell id="e_found_no" value="ไม่พบ" edge="1" parent="1" source="dec_found" target="send_404" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;">
