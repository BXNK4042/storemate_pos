        </mxCell>
        <mxCell id="e_action_scan" value="scan" edge="1" parent="1" source="dec_action" target="find_item" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;">
