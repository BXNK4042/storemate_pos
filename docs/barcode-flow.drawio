        </mxCell>
        <mxCell id="e_find_dec" edge="1" parent="1" source="find_item" target="dec_found" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;">
          <mxGeometry relative="1" as="geometry" />
