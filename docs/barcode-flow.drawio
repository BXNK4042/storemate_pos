        </mxCell>
        <mxCell id="e_calc_send" edge="1" parent="1" source="calc_totals" target="send_200_cart" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;">
          <mxGeometry relative="1" as="geometry" />
